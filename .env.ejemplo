# Copia a .env y rellena. .env no entra en git ni en las imágenes de Docker.

# LLM del agente (Gemini por defecto; ver CLAUDE.md para otros proveedores)
GEMINI_API_KEY=

# Firma de las cookies de sesión de la consola (cualquier texto largo y aleatorio).
# Sin ella, las sesiones se pierden cada vez que se reinicia el backend.
WEB_SECRETO=

# Entrada pública de alertas: POST http://<host>:8001/api/ingesta/alertas con la cabecera X-API-Key: <INGESTA_TOKEN>.
# Vacío = ruta desactivada (503). Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGESTA_TOKEN=
# Envíos por IP y minuto (por defecto 30)
INGESTA_POR_MINUTO=30

# Contraseña de PostgreSQL (usuarios de la consola). Por defecto «socdemo».
POSTGRES_PASSWORD=

# Puertos (Docker): backend público en 0.0.0.0:8001; pon BACKEND_HOST=127.0.0.1 para dejarlo solo en este equipo.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
